{
  "name": "shopping-price-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf": "vitest run src/perf.test.ts --reporter=verbose --silent=false",
    "perf:render": "playwright test --config playwright.perf.config.ts",
    "phone": "npm run build && vite preview --host",
    "icons": "node scripts/generate-icons.mjs",
    "build:pages": "vite build --base=/shopping-price-web/ --outDir dist-pages --emptyOutDir",
    "preview:pages": "vite preview --base=/shopping-price-web/ --outDir dist-pages --port 4373 --strictPort",
    "verify:deploy": "playwright test --config playwright.deploy.config.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
